# Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/recipe-management?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SESSION_SECRET=your_super_secret_session_key_here
NODE_ENV=development
PORT=3000

# Instructions:
# 1. Replace <username>, <password>, and <cluster-name> with your MongoDB Atlas credentials
# 2. Set up Google OAuth at https://console.developers.google.com
# 3. Generate a random SESSION_SECRET (use a password generator)
# 4. For production (Render), change NODE_ENV to 'production'