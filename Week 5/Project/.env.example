# Environment Variables Template
# Copy this to .env and update with your actual values

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/recipe-management?retryWrites=true&w=majority

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_here

# Application Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# Instructions:
# 1. Replace <username>, <password>, and <cluster-name> with your MongoDB Atlas credentials
# 2. Set up Google OAuth at https://console.developers.google.com (optional for basic functionality)
# 3. Generate a random SESSION_SECRET (use a password generator)
# 4. For production (Render), change NODE_ENV to 'production'

# For Render Deployment:
# - Add these as Config Vars in your Render dashboard
# - Set NODE_ENV=production
# - PORT will be automatically set by Render