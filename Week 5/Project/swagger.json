    "title": "Recipe Management API",
    "description": "API for managing recipes with full CRUD operations",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://recipe-project-f7mh.onrender.com",
      "description": "Production server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/recipes/": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "type": "string"
          },
          {
            "name": "difficulty",
            "in": "query",
            "type": "string"
          },
          {
            "name": "search",
            "in": "query",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "description": "Create a new recipe",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recipe"
              },
              "example": {
                "title": "Fresh Tomato Salsa",
                "description": "A vibrant and fresh homemade salsa perfect for chips or tacos",
                "ingredients": [
                  "4 large ripe tomatoes, diced",
                  "1 medium red onion, finely chopped",
                  "2-3 jalapeño peppers, seeded and minced",
                  "1/4 cup fresh cilantro, chopped",
                  "2 cloves garlic, minced",
                  "2 tablespoons lime juice",
                  "1 teaspoon salt",
                  "1/2 teaspoon ground cumin"
                ],
                "instructions": [
                  "Dice tomatoes and place in a large bowl",
                  "Add finely chopped red onion",
                  "Remove seeds from jalapeños and mince finely",
                  "Chop fresh cilantro and mince garlic",
                  "Add jalapeños, cilantro, and garlic to tomatoes",
                  "Squeeze fresh lime juice over mixture",
                  "Add salt and cumin",
                  "Mix all ingredients thoroughly",
                  "Let sit for 30 minutes to allow flavors to meld",
                  "Taste and adjust seasoning as needed"
                ],
                "cookTime": 15,
                "difficulty": "Easy",
                "category": "Appetizer",
                "nutrition": {
                  "calories": 25,
                  "protein": 1,
                  "carbs": 6,
                  "fat": 0
                },
                "tags": ["vegan", "gluten-free", "healthy", "mexican", "appetizer"],
                "servings": 8,
                "isPublic": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recipe created successfully"
          },
          "400": {
            "description": "Bad Request - Validation failed"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/recipes/{id}": {
      "get": {
        "summary": "Get a recipe by ID",
        "description": "Retrieve a specific recipe by its ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Recipe ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "summary": "Update a recipe",
        "description": "Update an existing recipe by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Recipe ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Updated Tropical Paradise Smoothie"
                  },
                  "description": {
                    "type": "string",
                    "example": "Extra refreshing smoothie with mango, pineapple, and coconut"
                  },
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "1 cup frozen mango chunks",
                      "1/2 cup frozen pineapple chunks",
                      "1 banana",
                      "1/2 cup coconut milk",
                      "1/4 cup orange juice",
                      "2 tablespoons honey",
                      "1/2 cup ice cubes",
                      "Toasted coconut flakes for garnish"
                    ]
                  },
                  "instructions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "Add mango, pineapple, and banana to blender",
                      "Pour in coconut milk and orange juice",
                      "Add honey for extra sweetness",
                      "Add ice cubes",
                      "Blend on high speed for 60 seconds until smooth",
                      "Taste and adjust sweetness if needed",
                      "Pour into glasses",
                      "Garnish with toasted coconut flakes",
                      "Serve immediately with a straw"
                    ]
                  },
                  "cookTime": {
                    "type": "number",
                    "example": 5
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": ["Easy", "Medium", "Hard"],
                    "example": "Easy"
                  },
                  "category": {
                    "type": "string",
                    "enum": ["Appetizer", "Main Course", "Dessert", "Beverage", "Snack", "Breakfast"],
                    "example": "Beverage"
                  },
                  "nutrition": {
                    "type": "object",
                    "properties": {
                      "calories": {
                        "type": "number",
                        "example": 175
                      },
                      "protein": {
                        "type": "number",
                        "example": 2
                      },
                      "carbs": {
                        "type": "number",
                        "example": 38
                      },
                      "fat": {
                        "type": "number",
                        "example": 4
                      }
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": ["smoothie", "tropical", "healthy", "vegan", "no-cook", "refreshing"]
                  },
                  "servings": {
                    "type": "number",
                    "example": 2
                  },
                  "isPublic": {
                    "type": "boolean",
                    "example": true
                  }
                },
                "required": ["title", "description", "ingredients", "instructions", "cookTime", "difficulty", "category", "servings"]
              },
              "example": {
                "title": "Updated Tropical Paradise Smoothie",
                "description": "Extra refreshing smoothie with mango, pineapple, and coconut",
                "ingredients": [
                  "1 cup frozen mango chunks",
                  "1/2 cup frozen pineapple chunks",
                  "1 banana",
                  "1/2 cup coconut milk",
                  "1/4 cup orange juice",
                  "2 tablespoons honey",
                  "1/2 cup ice cubes",
                  "Toasted coconut flakes for garnish"
                ],
                "instructions": [
                  "Add mango, pineapple, and banana to blender",
                  "Pour in coconut milk and orange juice",
                  "Add honey for extra sweetness",
                  "Add ice cubes",
                  "Blend on high speed for 60 seconds until smooth",
                  "Taste and adjust sweetness if needed",
                  "Pour into glasses",
                  "Garnish with toasted coconut flakes",
                  "Serve immediately with a straw"
                ],
                "cookTime": 5,
                "difficulty": "Easy",
                "category": "Beverage",
                "nutrition": {
                  "calories": 175,
                  "protein": 2,
                  "carbs": 38,
                  "fat": 4
                },
                "tags": ["smoothie", "tropical", "healthy", "vegan", "no-cook", "refreshing"],
                "servings": 2,
                "isPublic": true
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recipe updated successfully - No Content"
          },
          "400": {
            "description": "Bad Request - Validation failed"
          },
          "404": {
            "description": "Recipe not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "summary": "Delete a recipe",
        "description": "Delete a recipe by its ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
