    "/api/auth/current-user": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get current authenticated user",
        "description": "Returns the currently authenticated user\\'s information. Use this to test if authentication is working.",
        "responses": {
          "200": {
            "description": "Current user retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "User not authenticated - try GET /api/auth/google first",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": false
                },
                "message": {
                  "type": "string",
                  "example": "Not authenticated"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "🚨 IMPORTANT: Do NOT use Execute button!",
        "description": "OAuth requires browser redirect. COPY this URL and paste in new browser tab: http://localhost:3000/api/auth/google. OR This if Online: https://recipe-project-f7mh.onrender.com/api/auth/google. After login, return here and test protected endpoints.",
        "responses": {
          "302": {
            "description": "Redirect to Google OAuth (only works in browser, not AJAX)",
            "headers": {
              "Location": {
                "description": "Google OAuth URL",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Google OAuth callback",
        "description": "Handles the callback from Google OAuth and redirects user",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout user",
        "description": "Logs out the current user and destroys the session",
        "responses": {
          "200": {
            "description": "User logged out successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "Logged out successfully"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get user profile",
        "description": "Get detailed profile information for the authenticated user",
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "data": {
                  "$ref": "#/definitions/User"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "User not authenticated"
          }
        }
      },
      "put": {
        "tags": [
          "Authentication"
        ],
        "summary": "Update user profile",
        "description": "Update the authenticated user\\'s profile information",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Profile update data",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "bio": {
                  "type": "string",
                  "example": "string"
                },
                "dietaryPreferences": {
                  "type": "array",
                  "example": [
                    "string"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "cookingSkillLevel": {
                  "type": "string",
                  "example": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
